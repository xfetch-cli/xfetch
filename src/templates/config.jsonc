{
    "layout": "section",
    "os_wsl_style": "minimal",
    "modules": [
        {
            "type": "group",
            "title": "Hardware",
            "modules": [
                "hostname",
                "cpu",
                "gpu",
                "memory",
                "swap",
                "disk",
                "battery"
            ]
        },
        {
            "type": "group",
            "title": "Software",
            "modules": [
                "os",
                "kernel",
                "packages",
                "shell",
                "wm",
                "terminal",
                "local_ip"
            ]
        },
        {
            "type": "group",
            "title": "Session",
            "modules": [
                "user",
                "uptime",
                "datetime"
            ]
        },
        "palette"
    ],
    "show_colors": true,
    "icons": {
        "hostname": "",
        "cpu": "",
        "gpu": "󰍹",
        "memory": "",
        "swap": "�",
        "disk": "󰋊",
        "battery": "",
        "os": "",
        "kernel": "",
        "packages": "",
        "shell": "",
        "wm": "",
        "terminal": "",
        "local_ip": "󰩟",
        "user": "",
        "uptime": "󰔛",
        "datetime": "",
        "palette": "",
        "hardware": "",
        "software": "",
        "session": ""
    },
    "colors": {
        "hostname": "Green",
        "cpu": "Green",
        "gpu": "Green",
        "memory": "Green",
        "swap": "Green",
        "disk": "Green",
        "battery": "Green",
        "os": "Yellow",
        "kernel": "Yellow",
        "packages": "Yellow",
        "shell": "Yellow",
        "wm": "Yellow",
        "terminal": "Yellow",
        "local_ip": "Yellow",
        "user": "Magenta",
        "uptime": "Magenta",
        "datetime": "Magenta",
        "palette": "White"
    },
    // Rename the key shown per module ("cpu" -> "procesador"); an empty
    // string hides it (icon-only row). Omit the module to keep its name.
    "labels": {
        "cpu": "",
        "gpu": ""
    },
    // Value templates with {field} placeholders. Every module exposes
    // {value} and {key}; CPU adds {brand}, {model}, {cores} and {freq};
    // GPU adds {name}, {vendor}, {model} and {vram}. Unknown fields render
    // empty; {{ }} escapes literal braces. Omit a module to keep its
    // default output.
    "formats": {
        "cpu": "{model} · {cores} núcleos · {freq}",
        "gpu": "{vendor} {model}"
    },
    "palette_style": "circles"
}
